FROM node:22-bookworm-slim
WORKDIR /opt/atoms
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/atoms/browsers
RUN npm install --ignore-scripts --no-audit --no-fund playwright@1.51.1 \
    && npx playwright install --with-deps --only-shell chromium \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/acceptance/browser.cjs /opt/atoms/browser.cjs
